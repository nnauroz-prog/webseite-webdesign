# --- Anthropic API (Hero-Chat-Assistent) ---
# API-Key von https://console.anthropic.com → API Keys. Server-side ONLY.
# Ohne diesen Key liefert /api/chat eine ruhige 503-Antwort und der
# Hero-Chat zeigt einen Hinweis, statt zu crashen.
ANTHROPIC_API_KEY=

# --- Site URL ---
# Öffentliche Canonical-URL — wird in Metadata, robots.txt und sitemap.xml
# verwendet. Lokal: http://localhost:3000, Production: https://www.sitalo.de.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: Anfragen speichern + Admin-Bereich (/admin) ---
# Einrichtung, einmalig:
#  1. supabase.com → New project (Region: Frankfurt / eu-central-1).
#  2. SQL Editor → Inhalt von supabase/migrations/20261030000000_leads.sql
#     einfügen → Run.
#  3. Authentication → Sign In / Providers → „Allow new users to sign up"
#     AUS. Dann Authentication → Users → Add user → deine E-Mail +
#     Passwort, „Auto Confirm User" an.
#  4. Project Settings → API Keys: die Werte unten in Vercel eintragen
#     (Settings → Environment Variables), Redeploy.
# Ohne diese Variablen läuft die Site weiter; Anfragen gehen dann nur
# per Mail raus und /admin zeigt „Noch nicht eingerichtet".
NEXT_PUBLIC_SUPABASE_URL=
# Öffentlicher Schlüssel („anon" bzw. „publishable"). Darf im Browser stehen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM („service_role" bzw. „secret"). Nur in Vercel, nie ins Repo,
# nie in einen Chat. Umgeht alle Zugriffsregeln der Datenbank.
SUPABASE_SERVICE_ROLE_KEY=
# Wer /admin sehen darf, kommagetrennt. Muss zum Supabase-Nutzer passen.
ADMIN_EMAILS=

# --- Anfrage-Zustellung (Anfrage, Audit, Termin → /api/anfrage) ---
# Alle drei Formulare schicken an /api/anfrage; der Server stellt per
# Mail zu und schreibt jeden Fehler ins Vercel-Log (Suche: „[anfrage]").
#
# Bevorzugt: Resend (https://resend.com → API Keys). Ohne verifizierte
# Domain darf Resend nur an die E-Mail-Adresse des Resend-Kontos
# senden — also mit info@sitalo.de registrieren, oder sitalo.de unter
# Domains verifizieren und LEAD_MAIL_FROM auf z. B.
# „Sitalo Website <anfragen@sitalo.de>" setzen.
RESEND_API_KEY=
# Empfänger der Anfragen. Default: info@sitalo.de
LEAD_MAIL_TO=
# Absender. Default: „Sitalo Website <onboarding@resend.dev>"
LEAD_MAIL_FROM=

# Fallback, solange RESEND_API_KEY leer ist: Formspree, jetzt server-
# seitig. Form-ID von https://formspree.io (Teil nach /f/ in der URL).
# Ist weder RESEND_API_KEY noch FORMSPREE_FORM_ID gesetzt, sehen
# Besucher eine Fehlermeldung mit info@sitalo.de statt einer falschen
# Erfolgsmeldung.
FORMSPREE_FORM_ID=

# --- PageSpeed Insights (Speed-Check-Tool) ---
# Optional, aber dringend empfohlen für Production. Ohne Key teilt
# sich /api/speed-check die anonyme Google-Quota mit anderen Vercel-
# Functions — das führt regelmäßig zu HTTP 429. Key holen unter
# https://console.cloud.google.com → APIs → Library →
# „PageSpeed Insights API" aktivieren → Credentials → API key.
# Ohne Key (oder wenn Google ausfällt) zeigt /check einen eigenen
# Basis-Check (Antwortzeit, Größe, HTTPS, Handy, Titel) statt Punkten.
PAGESPEED_API_KEY=

# --- Plausible Analytics (Privacy-First, kein Cookie-Banner nötig) ---
# Die Plausible-Domain (typisch: sitalo.de). Wenn gesetzt, lädt die
# Site das Plausible-Script und feuert Conversion-Events (Anfrage,
# Audit) automatisch. Wenn leer, kein Tracking — track() ist No-Op.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: Self-Hosting oder Plausible-kompatible Alternative.
# Default ist https://plausible.io/js/script.outbound-links.js.
# Beispiel für Self-Hosting: https://analytics.sitalo.de/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
